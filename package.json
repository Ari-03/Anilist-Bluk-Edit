{
    "name": "anilist-bulk-edit",
    "version": "0.1.0",
    "private": true,
    "description": "A web application for bulk editing AniList anime and manga entries",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:lighthouse": "node scripts/run-lighthouse.mjs",
        "check:bundle": "node scripts/check-first-load-budget.mjs",
        "audit:production": "npm audit --omit=dev --audit-level=high"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "cookie": "^1.0.2",
        "idb": "^8.0.3",
        "lucide-react": "^0.475.0",
        "motion": "^12.42.2",
        "next": "16.2.10",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@axe-core/playwright": "^4.12.1",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "1.61.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/cookie": "^0.6.0",
        "@types/node": "^24.13.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.1.10",
        "autoprefixer": "^10.4.27",
        "eslint": "^10.7.0",
        "eslint-config-next": "16.2.10",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.1.1",
        "msw": "^2.15.0",
        "postcss": "^8.5.8",
        "tailwindcss": "3.4.19",
        "typescript": "5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
